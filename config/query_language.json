  "sections": {
    "business-overview": {
      "patterns": [
        "make money|makes money|business model|what .*do|what .*manufacture|business overview",
        "מודל ה?עסקי|עושה כסף|מרוויחה כסף|מה .*עושה|מייצר"
      ],
      "search_terms": "business sells services products customers"
    },
    "revenue-model-and-segments": {
      "patterns": [
        "segment|business mix|revenue stream",
        "מגזר|סגמנט|חלוקת הכנסות"
      ],
      "search_terms": "reporting segments revenue"
    },
    "products-and-services": {
      "patterns": [
        "product|programs|manufacture|hbm4|socamm|gpu|cpu",
        "מוצר|מייצר|תוכנות|פלטפורמות"
      ],
      "search_terms": "products services platforms"
    },
    "customers-and-end-markets": {
      "patterns": [
        "customer|end market|buyers",
        "לקוחות|לקוח|שווקי יעד"
      ],
      "search_terms": "customers end markets"
    },
    "industry-and-value-chain": {
      "patterns": [
        "value chain|supply constraint|industry",
        "שרשרת ערך|ענף|תעשיי"
      ],
      "search_terms": "industry supply manufacturing"
    },
    "competitive-landscape": {
      "patterns": [
        "competitor|competition|compete",
        "מתחר|תחרות"
      ],
      "search_terms": "competitors competition"
    },
    "moat-and-differentiation": {
      "patterns": [
        "moat|differentiation|switching cost",
        "חפיר|בידול|יתרון תחרותי"
      ],
      "search_terms": "moat switching qualification"
    },
    "growth-drivers": {
      "patterns": [
        "growth driver|growth mechanism|growth opportunity",
        "גורמי ה?צמיחה|מנועי ה?צמיחה|תצמח"
      ],
      "search_terms": "growth demand adoption"
    },
    "financial-performance": {
      "patterns": [
        "revenue|earnings|profit|gross margin|financial performance|financial results|gaap|ebitda|eps",
        "הכנסות|רווח|תוצאות כספיות|תוצאות פיננסיות|שיעור צמיחה"
      ],
      "search_terms": "revenue earnings net income GAAP fiscal"
    },
    "balance-sheet-and-capital-allocation": {
      "patterns": [
        "cash|debt|balance sheet|capital allocation|capex|lease",
        "מזומן|חוב|מאזן|תזרים|השקעות הוניות"
      ],
      "search_terms": "cash debt capital expenditures"
    },
    "management-and-governance": {
      "patterns": [
        "management|governance|ceo|cfo|leadership|president",
        "הנהלה|מנכל|מנכ״ל|מנכ\\\"ל|להוביל|מוביל|ממשל תאגידי"
      ],
      "search_terms": "CEO management president board"
    },
    "valuation-context": {
      "patterns": [
        "valuation context|valuation method|value the business",
        "שיטת הערכת שווי|הקשר הערכת שווי"
      ],
      "search_terms": "valuation GAAP cash"
    },
    "catalysts": {
      "patterns": [
        "catalyst|milestone|output target|production capacity|next results|earnings date",
        "קטליזטור|זרז|אבני דרך|מועד הדוח|מועד פרסום"
      ],
      "search_terms": "catalysts targets monitor scheduled"
    },
    "risks-and-thesis-breakers": {
      "patterns": [
        "risk|threat|thesis breaker|scar|powder metal|control weakness",
        "סיכון|סיכונ|עלול לפגוע|שבירת תזה"
      ],
      "search_terms": "risks controls competition delays"
    },
    "scenarios-and-open-questions": {
      "patterns": [
        "scenario|bull|bear|open question",
        "תרחיש|שאלות פתוחות"
      ],
      "search_terms": "scenarios assumptions uncertainties"
    },
    "relationships-and-themes": {
      "patterns": [
        "relationship|collaboration|partnership|joint venture",
        "קשר|שותפות|שיתוף פעולה"
      ],
      "search_terms": "relationship partnership supplier ownership"
    },
    "recent-developments": {
      "patterns": [
        "recent development|what changed|dividend|announced|completed payment",
        "מה השתנה|התפתחות|דיבידנד|חדשות"
      ],
      "search_terms": "recent announced developments declared"
    }
  },
  "unsupported": [
    {
      "code": "live_market_data",
      "pattern": "stock price|share price|trading at|market cap|market value|(?:current|live|today).*price|price.*(?:today|now)|p/e|pe ratio|forward multiple|מחיר.*(?:היום|עכשיו|מניה|מניית)|המחיר של|שווי שוק|מכפיל",
      "reason": "Research lookup does not provide live prices or valuation multiples. A separate dated market snapshot is available in the desk."
    },
    {
      "code": "unsourced_forecast",
      "pattern": "consensus|price target|fair value|analyst.*(?:forecast|estimate)|קונצנזוס|מחיר יעד|מחיר היעד|שווי הוגן|תחזית אנליסטים|תחזיות אנליסטים",
      "reason": "Analyst consensus, price targets and fair value are not sourced."
    },
    {
      "code": "investment_action",
      "pattern": "should i (?:buy|sell)|which stock.*buy|האם לקנות|כדאי לקנות|איזו מניה לקנות",
      "reason": "This research assistant does not produce personalized buy or sell recommendations."
    }
  ],
  "themes": {
    "בינה מלאכותית": "ai",
    "ענן": "cloud",
    "זיכרון": "memory",
    "ביטחון": "defense",
    "שבבים": "semiconductors"
  }
