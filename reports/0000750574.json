ecember 9, 2022 by the Company’s and the Bank’s Compensation Committees. Beginning January 1, 2023, Mr. Dumas’ annual salary will be $135,000, Mr. Hedges’ annual salary will be $300,000, and Mr. Walker’s annual salary will be $235,000."}]},"url":"https://www.sec.gov/Archives/edgar/data/750574/000119312522306015/d393778d8ka.htm"},{"accession":"0001193125-25-156220","filed":"2025-07-07","form":"8-K/A","id":"F000119312525156220","partial_document":true,"period_end":null,"retrieved_at":"2026-11-17T21:31:13.165122+00:00","sha256":"015950357ecb267f2ee1c9fc66ab6756e3c90d6fc7e4fa9d849d26f587022485","text_sha256":"5a22f08ed12a921ab6d8ed47d26b67af0de38e682fa48941a6a221c2e3d2336c","topics":{},"url":"https://www.sec.gov/Archives/edgar/data/750574/000119312525156220/d944558d8ka.htm"},{"accession":"0001193125-26-111012","filed":"2026-03-17","form":"10-K","id":"F000119312526111012","partial_document":true,"period_end":"2025-12-31","retrieved_at":"2026-11-17T21:31:15.239665+00:00","sha256":"fdc52d43b1b3445d52063f3a2d1778bfeb442eec69a1a5aaaaf7b7c0ef1ca885","text_sha256":"9cd3eb58b4c4f55e6c613faeb0fb0c028c793e516ae24dcd35dcac4dbfe535f7","topics":{},"url":"https://www.sec.gov/Archives/edgar/data/750574/000119312526111012/d87304d10k.htm"},{"accession":"0001193125-26-139480","filed":"2026-04-02","form":"DEF 14A","id":"F000119312526139480","partial_document":true,"period_end":null,"retrieved_at":"2026-11-17T21:31:17.102049+00:00","sha256":"31e9b8e898fabf98bed1a54467b757aa61dcfba1aeacd22f0b40f2881c6bf3e1","text_sha256":"0ac83b09bce73019d775268c90d185b25e4525b7b157e4b3ff693f96cc14430f","topics":{"management-and-governance":[{"id":"F000119312526139480-management-and-governance-947","locator":"L947","partial":false,"sha256":"e82f5634a8f65e6f4d742f995976ec56287a4004326630914243716a13c34d60","source_id":"F000119312526139480","text":"accordance with the recommendation of the Board of Directors as to all such matters. Specifically, your shares"},{"id":"F000119312526139480-management-and-governan